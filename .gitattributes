# Text is stored in the repository as LF and checked out as LF.
* text=auto eol=lf

# cmd.exe reads batch files as CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary, never line-ending converted and never diffed as text.
*.rds binary
*.rda binary
*.RData binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
