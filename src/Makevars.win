# Enable OpenMP
# -fno-strict-aliasing: Prevents optimizer from assuming type-based aliasing
# This fixes heisenbugs where the optimizer breaks code due to aliasing assumptions
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DNDEBUG -fno-strict-aliasing
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS)
CXX_STD = CXX17

# Compile hmc_sampler.cpp with -O1 to prevent heisenbug in GP models
# Higher optimization levels cause crashes in the NNGP likelihood computation
hmc_sampler.o: hmc_sampler.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -O1 -c $< -o $@
